---
interface Props {
  pub: {
    title: string;
    authors: string;
    venue: string;
    link?: string;
    hidden: boolean;
    year?: string;
  };
}

const { pub } = Astro.props;
---

<div class:list={["pub-item", { hidden: pub.hidden }]}>
  <div class="pub-title">
    {pub.link ? (
      <a href={pub.link} target="_blank" rel="noopener noreferrer" class="pub-link">
        {pub.title}
      </a>
    ) : (
      pub.title
    )}
  </div>
  <div class="pub-meta">
    {pub.authors} · <span class="pub-venue"
      >{pub.venue} {pub.year && `(${pub.year})`}</span>
  </div>
</div>

<style>
  .pub-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .pub-item:first-child {
    padding-top: 0;
  }

  :global(.pub-list > :last-child) .pub-item,
  :global(.pub-list > .pub-item:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pub-title {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
    line-height: 1.5;
  }

  .pub-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 2px;
  }

  .pub-link:hover {
    color: var(--accent);
  }

  .pub-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .pub-venue {
    color: var(--accent);
    font-weight: 500;
  }

  .pub-item.hidden {
    display: none;
  }

  :global(.bento-card.expanded) .pub-item.hidden {
    display: block;
  }

  :global(.bento-card.expanded) .pub-item {
    padding: 1.25rem;
    background: var(--bg-secondary);
    border-radius: 8px;
    border-bottom: none;
  }
</style>
