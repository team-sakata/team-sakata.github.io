---
import { parseInlineLinks } from "../utils/richText";
import { detectLocale } from "../utils/paths";
import { getNewsPath, getNewsText, getNewsTitle, hasNewsDetail, type NewsEntry } from "../utils/news";

interface Props {
  news: NewsEntry;
}

const { news } = Astro.props;
const locale = detectLocale(Astro.url.pathname);
const segments = parseInlineLinks(getNewsText(news, locale));
---

<div class="news-item">
  <div class="news-date">{news.date}</div>
  <div class="news-text">
    {hasNewsDetail(news) ? (
      <a class="news-link" href={getNewsPath(news, locale)}>{getNewsTitle(news, locale)}</a>
    ) : (
      segments.map((segment) =>
        segment.type === "link" ? (
          <a
            href={segment.href}
            target={segment.external ? "_blank" : undefined}
            rel={segment.external ? "noopener noreferrer" : undefined}
            class="news-link"
          >
            {segment.value}
          </a>
        ) : (
          segment.value
        ),
      )
    )}
  </div>
</div>

<style>
  .news-item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .news-date {
    font-size: 0.85rem;
    color: var(--accent);
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .news-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .news-item.hidden {
    display: none;
  }

  :global(.bento-card.expanded) .news-item.hidden {
    display: flex;
  }

  :global(.bento-card.expanded) .news-item {
    padding: 1rem;
    background: var(--bg-secondary);
    border-radius: 8px;
    flex-direction: column;
    gap: 0.4rem;
  }

  .news-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 2px;
  }

  .news-link:hover {
    color: var(--accent);
  }

</style>
